NODE_ENV=production
MCP_HOST=127.0.0.1
MCP_PORT=3210
# Requis avec MCP_HOST=0.0.0.0, notamment dans Docker. Valeurs séparées par des virgules.
MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
FOUNDRY_BRIDGE_SECRET=replace-with-a-different-long-random-secret
TARGET_WORLD_ID=my-world
FOUNDRY_ORIGIN=https://foundry.example.com
AUDIT_LOG_PATH=./data/audit.jsonl
LOG_LEVEL=info

# Session GM headless facultative, exécutée et supervisée par le serveur MCP.
FOUNDRY_HEADLESS_ENABLED=false
FOUNDRY_HEADLESS_URL=http://127.0.0.1:30000
FOUNDRY_HEADLESS_USERNAME=MCP Bridge GM
FOUNDRY_HEADLESS_ACCESS_KEY=replace-with-a-dedicated-foundry-access-key
FOUNDRY_HEADLESS_BRIDGE_URL=ws://127.0.0.1:3210/foundry-mcp/bridge
FOUNDRY_HEADLESS_CHROMIUM_PATH=/usr/bin/chromium
FOUNDRY_HEADLESS_PROFILE_PATH=./data/chromium-profile
FOUNDRY_HEADLESS_RETRY_MS=10000
FOUNDRY_HEADLESS_BRIDGE_GRACE_MS=60000
