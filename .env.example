NODE_ENV=production
MCP_HOST=127.0.0.1
MCP_PORT=3210
# Required when MCP_HOST=0.0.0.0 (Docker): comma-separated public hostnames.
MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1

# MCP clients authenticate to /mcp with this bearer token.
MCP_BEARER_TOKEN=replace-with-a-long-random-secret
# The Foundry browser module uses this independent secret for the control channel.
FOUNDRY_BRIDGE_SECRET=replace-with-a-different-long-random-secret

TARGET_WORLD_ID=my-world
FOUNDRY_ORIGIN=https://foundry.example.com
# Defaults to FOUNDRY_ORIGIN when unset; use the internal Foundry URL if different.
FOUNDRY_DIRECT_URL=http://127.0.0.1:30000
FOUNDRY_DIRECT_CREDENTIALS_PATH=./data/foundry-direct-credentials.json

# AgentControl daemon on the same host. The token is read only by this service
# and is never sent to the browser module.
AGENTCONTROL_TCP=127.0.0.1:7331
#AGENTCONTROL_TOKEN_PATH=/config/.agentcontrol/daemon.token
AGENTCONTROL_WORKSPACE=/data/agent-workspace
AGENTCONTROL_SLOTS_PATH=./data/agentcontrol-slots.json
# Experimental pass-through of Foundry MCP tools into slot agents; disabled by default.
AGENTCONTROL_INJECT_FOUNDRY_MCP=false

# Local Plutonium/5etools JSON data directory, indexed by the backend without
# executing Plutonium in a browser.
#PLUTONIUM_DATA_PATH=/data/Data/modules/plutonium/data

AUDIT_LOG_PATH=./data/audit.jsonl
LOG_LEVEL=info
NORMAL_OPERATION_TIMEOUT_MS=30000
BRIDGE_HEARTBEAT_TIMEOUT_MS=60000
DELETE_CONFIRMATION_TTL_MS=120000
MAX_JSON_BODY_BYTES=2097152
